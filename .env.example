# Testnet identities are Stellar CLI aliases. Missing aliases are generated and Friendbot-funded by deploy.
STELLAR_FEE_PAYER_IDENTITY=agentallowance-fee-payer
STELLAR_RELAYER_IDENTITY=agentallowance-relayer
STELLAR_ADMIN_IDENTITY=agentallowance-admin
STELLAR_DELEGATE_IDENTITY=agentallowance-delegate
STELLAR_DELEGATE_2_IDENTITY=agentallowance-delegate-2
STELLAR_MERCHANT_IDENTITY=agentallowance-merchant
STELLAR_UNAPPROVED_RECIPIENT_IDENTITY=agentallowance-unapproved-recipient

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Official Testnet USDC SAC used by the submission evidence.
STELLAR_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_DECIMALS=7

FUND_AMOUNT=5000000
PAYMENT_AMOUNT=100000
SPENDING_LIMIT=1000000
PERIOD_LEDGERS=17280
ALLOWANCE_LIFETIME_LEDGERS=17280
# 60 seconds gives hosted verify + settle 12 Testnet ledgers while remaining tightly bounded.
MAX_TIMEOUT_SECONDS=60

# Point this at the self-hosted policy-aware facilitator, not the incompatible hosted endpoint.
X402_FACILITATOR_URL=http://127.0.0.1:8080/api/v1/plugins/x402-facilitator/call
# X402_FACILITATOR_API_KEY=

# Emergency API fallback. The primary operator login uses a Freighter-signed owner challenge.
CONSOLE_AUTH_USERNAME=operator
CONSOLE_AUTH_PASSWORD=

# Omit these locally to namespace SQLite files by treasury contract automatically.
# DATABASE_URL=./data/agentallowance.db
# DEMO_DATABASE_URL=./data/demo-api.db
DEMO_SERVICE_URL=http://127.0.0.1:3001
DEMO_API_PORT=3001
CONSOLE_API_PORT=3000
PUBLIC_DEMO_ALLOWANCE_ID=1
PUBLIC_DEMO_SUCCESS_COOLDOWN_MS=3600000

# Multi-wallet Testnet onboarding. Each connected wallet gets its own deterministic treasury.
TREASURY_WASM_HASH=27a6c9e10a9046899ab76c0191de6efe2cf678d36eeb385277a5afe07bea040a
OWNER_TREASURY_VERSION=treasury-v1
OWNER_INITIAL_SPENDING_LIMIT=1000000
OWNER_PERIOD_LEDGERS=720
OWNER_ALLOWANCE_LIFETIME_LEDGERS=17280
# Set to 0 to disable the one-time Testnet onboarding faucet.
OWNER_INITIAL_FUNDING_ATOMIC=100000
# OWNER_DATABASE_DIRECTORY=./data/owners

# Hosted console/API deployments do not read ignored local artifacts or Stellar CLI aliases.
# Set these in the hosting provider; keep every *_SECRET value in secret storage only.
# TREASURY_CONTRACT=C...
# STELLAR_ADMIN_ADDRESS=G...
# SPENDING_POLICY_CONTRACT=C...
# RECIPIENT_POLICY_CONTRACT=C...
# STELLAR_MERCHANT_ADDRESS=G...
# STELLAR_UNAPPROVED_RECIPIENT_ADDRESS=G...
# STELLAR_ADMIN_SECRET= # optional emergency fallback; omit for wallet-only admin custody
# STELLAR_FEE_PAYER_SECRET=
# STELLAR_DELEGATE_SECRETS=

# authorize creates a new append-only attempt for one of these scenarios.
# SCENARIO=successful-payment
# SCENARIO=over-limit
# SCENARIO=unapproved-recipient
# PAYMENT_AMOUNT_OVERRIDE=
# PAYMENT_RECIPIENT_OVERRIDE=
# ALLOWANCE_RULE_ID_OVERRIDE=2
# STELLAR_DELEGATE_IDENTITY_OVERRIDE=agentallowance-delegate-2

# /settle additionally requires ALLOW_SETTLEMENT=yes at invocation time.
